@using TilePlan.Core.Cutting
@using TilePlan.Core.Layout
@using TilePlan.Core.Tiles

<div class="panel">
    <h3>@(Piece.Kind == PieceKind.Full ? "整片磚" : $"切割片 {Piece.Label}")</h3>
    <dl class="stats">
        <dt>位置</dt><dd class="small">第 @Position.Row 排、第 @Position.Column 欄</dd>
        <dt>@(Piece.Kind == PieceKind.Full ? "尺寸" : "切後外框")</dt>
        <dd>@Fmt.Cm(Piece.LocalBounds.Width) × @Fmt.Cm(Piece.LocalBounds.Height) cm</dd>
        <dt>面積</dt><dd>@Fmt.Cm2(Piece.Area) cm²</dd>
        @if (Assignment is { } a)
        {
            <dt>切割清單</dt>
            <dd>
                <button class="btn small" @onclick="() => OnShowInCutList.InvokeAsync(Piece.CutNo)">原磚 S@(a.StockNo.ToString("00"))</button>
                <span class="small muted">@(a.FromOffcut ? "使用餘料" : "新開一片")@(a.RotationDeg != 0 ? $"，轉 {a.RotationDeg:0}°" : "")</span>
            </dd>
        }
    </dl>
    @if (Piece.Kind == PieceKind.Cut)
    {
        <svg viewBox="@($"{Svg.N(-2)} {Svg.N(-Lattice.TileV - 2)} {Svg.N(Lattice.TileU + 4)} {Svg.N(Lattice.TileV + 4)}")" style="width: 100%; height: auto; margin-top: 8px; background: var(--grout)">
            <g transform="scale(1,-1)">
                <rect x="0" y="0" width="@Svg.N(Lattice.TileU)" height="@Svg.N(Lattice.TileV)" fill="white" stroke="var(--muted)" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"></rect>
                <path class="svg-cut" d="@Svg.Path(Piece.LocalShape)"></path>
                @foreach (var (mid, text) in EdgeLabels())
                {
                    <SvgText X="mid.X" Y="mid.Y" Size="LabelSize" CssClass="svg-dim">@text</SvgText>
                }
            </g>
        </svg>
        <p class="small muted" style="margin: 4px 0 0">虛線為整片原磚 @Fmt.Cm(Lattice.TileU) × @Fmt.Cm(Lattice.TileV) cm，黃色為要留下的部分（各邊長單位 cm）。</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public Piece Piece { get; set; } = default!;
    [Parameter] public CutAssignment? Assignment { get; set; }
    [Parameter, EditorRequired] public LayoutResult Layout { get; set; } = default!;

    private Lattice Lattice => Layout.Lattice;

    /// <summary>細長磚（例如 120 × 20）若用長邊決定字級，文字會超出磚面，所以同時受短邊限制。</summary>
    private double LabelSize => Math.Min(Math.Max(Lattice.TileU, Lattice.TileV) / 14, Math.Min(Lattice.TileU, Lattice.TileV) * 0.3);
    private (int Row, int Column) Position => Layout.DisplayIndex(Piece);

    /// <summary>
    /// 切割形狀的邊長標示：同樣長度只標一次（細長條上下兩邊一樣長時，兩個標籤會疊在一起），
    /// 太短放不下文字的邊略過（外框尺寸已列在上方）。
    /// </summary>
    private IEnumerable<(TilePlan.Core.Geometry.Vec2 Mid, string Text)> EdgeLabels() =>
        Piece.LocalShape.Polygons
            .SelectMany(poly => poly.Edges())
            .Where(e => e.A.DistanceTo(e.B) >= LabelSize * 2.5)
            .GroupBy(e => Fmt.Cm(e.A.DistanceTo(e.B)))
            .Select(g => ((g.First().A + g.First().B) / 2, g.Key));
    [Parameter] public EventCallback<int> OnShowInCutList { get; set; }
}
