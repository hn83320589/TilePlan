@using TilePlan.Core.Cutting
@using TilePlan.Core.Estimation
@using TilePlan.Core.Geometry
@using TilePlan.Core.Layout
@inject ProjectStore Store
@inject TilePlanJs Js

@if (!Result.Ok)
{
    <div class="notice warn"><p>無法排版：@Result.Error</p></div>
}
else
{
    var lay = Result.Layout!;
    var materials = Result.Materials!;
    var report = Result.Offset!;
    <div class="columns">
        <div>
            <Canvas View="_view" OnClick="OnCanvasClick" Hint="滾輪縮放、拖曳平移；點選磚片查看尺寸">
                <Tools>
                    <label class="row small" style="background: white; padding: 0 6px; border-radius: 4px; gap: 4px">
                        縫寬
                        <input class="narrow" type="number" step="0.5" min="0" value="@Tile!.JointMm" @onchange="ChangeJoint" aria-label="縫寬（mm）" style="width: 64px" />
                        mm
                    </label>
                </Tools>
                <ChildContent>
                    <path class="svg-room" d="@_regionPath"></path>
                    @foreach (var ex in Room.Exclusions.Where(e => e.Vertices.Count >= 3))
                    {
                        <polygon class="svg-excl" points="@Svg.Points(ex.Vertices.Select(v => v.ToVec()))"></polygon>
                    }
                    <path class="svg-full" d="@_fullPath"></path>
                    <path class="svg-cut" d="@_cutPath"></path>
                    <path class="svg-reuse" d="@_reusePath"></path>
                    <path class="svg-room-outline" d="@_roomPath"></path>
                    @foreach (var w in _violations)
                    {
                        <line class="svg-viol" x1="@Svg.N(w.A.X)" y1="@Svg.N(w.A.Y)" x2="@Svg.N(w.B.X)" y2="@Svg.N(w.B.Y)"></line>
                    }
                    <line class="svg-baseline" x1="@Svg.N(_baseA.X)" y1="@Svg.N(_baseA.Y)" x2="@Svg.N(_baseB.X)" y2="@Svg.N(_baseB.Y)"></line>
                    <circle cx="@Svg.N(Room.BaselineOrigin.X)" cy="@Svg.N(Room.BaselineOrigin.Y)" r="@Svg.N(Size / 120)" fill="var(--ink)"></circle>
                    @if (_selected is not null)
                    {
                        <path class="svg-selected" d="@Svg.Path(_selected.Shape)"></path>
                    }
                </ChildContent>
            </Canvas>
            <div class="legend">
                <span><i style="background: var(--tile)"></i>整片 @lay.FullCount</span>
                <span><i style="background: var(--tape-soft)"></i>切割片 @(lay.CutCount - Result.Cuts!.ReusedCount)</span>
                <span><i style="background: var(--glaze)"></i>使用餘料的切割片 @Result.Cuts.ReusedCount</span>
                <span><i style="background: repeating-linear-gradient(45deg, #aab4b8 0 2px, #f1f3f3 2px 6px)"></i>不鋪設區</span>
                <span><i style="background: none; border: 0; border-top: 2px dashed var(--ink); height: 0; width: 18px"></i>基準線</span>
                @if (_violations.Count > 0) { <span><i style="background: none; border: 0; border-top: 3px solid var(--danger); height: 0; width: 18px"></i>切條不足的牆</span> }
            </div>
            <p class="small muted num" style="margin-top: 6px">
                排版計算 @Store.LastComputeMilliseconds(Room).ToString("0") ms
                @if (_lastTotalMs is { } total) { <span>；上次修改縫寬到畫面更新 @total.ToString("0") ms</span> }
                <button class="btn small no-print" style="margin-left: 8px" disabled="@_benchmarking" @onclick="Benchmark">量測 10 次</button>
                @if (_benchmark is not null) { <span>　@_benchmark</span> }
            </p>
        </div>

        <div>
            @if (report.Satisfied)
            {
                <div class="notice ok"><p>所有牆邊切條都不小於磚寬的 1/3@(report.MinWidth is { } m ? $"，最窄 {Fmt.Cm(m)} cm" : "")。</p></div>
            }
            else
            {
                <div class="notice warn">
                    <p>@report.Reasons[0]</p>
                    <ul>
                        @foreach (var reason in report.Reasons.Skip(1)) { <li>@reason</li> }
                    </ul>
                </div>
            }

            @if (_selected is { } piece)
            {
                <PieceInspector Piece="piece" Assignment="Result.Cuts!.Find(piece)" Layout="lay" OnShowInCutList="OnShowInCutList" />
            }

            <div class="panel">
                <h3>本間材料</h3>
                <dl class="stats">
                    <dt>可鋪面積</dt><dd><AreaText Area="Result.Area" /></dd>
                    <dt>整片＋切割用原磚</dt><dd>@materials.FullTiles ＋ @materials.StockForCuts</dd>
                    <dt>含損耗 @Fmt.Percent(materials.WasteRate)</dt><dd>@materials.TilesWithWaste 片（@MaterialEstimator.Boxes(materials.TilesWithWaste, Tile!.PiecesPerBox) 箱）</dd>
                    <dt>重用餘料</dt><dd>@Result.Cuts!.ReusedCount 片</dd>
                    <dt>黏著劑</dt><dd>@Fmt.Kg(materials.AdhesiveKg) kg</dd>
                    <dt>填縫劑</dt><dd>@Fmt.Kg(materials.GroutKg) kg</dd>
                    <dt>縫總長</dt><dd>@Fmt.Cm(materials.JointLengthCm / 100) m</dd>
                </dl>
                <p class="small muted" style="margin: 8px 0 0">箱數在報價單中依磁磚跨房間合併計算。</p>
            </div>

            <div class="panel">
                <h3>牆邊切條</h3>
                <table class="grid small">
                    <thead><tr><th>牆</th><th class="num">最窄</th><th class="num">門檻</th></tr></thead>
                    <tbody>
                        @foreach (var w in report.Walls)
                        {
                            <tr style="@(w.Satisfied ? "" : "color: var(--danger)")">
                                <td>@w.Name@(w.Oblique ? $"（斜 {w.AngleToGridDeg:0.#}°）" : "")</td>
                                <td class="num">@(w.MinWidth is { } mw ? Fmt.Cm(mw) : "無切割")</td>
                                <td class="num">@Fmt.Cm(w.Threshold)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Room Room { get; set; } = default!;
    [Parameter, EditorRequired] public RoomResult Result { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<int> OnShowInCutList { get; set; }

    private RoomResult? _renderedFor;
    private string _regionPath = "", _roomPath = "", _fullPath = "", _cutPath = "", _reusePath = "";
    private List<(Vec2 A, Vec2 B)> _violations = [];
    private Vec2 _baseA, _baseB;
    private Bounds _view;
    private string? _viewFor;
    private Piece? _selected;

    private double? _changeStartedAt;
    private double? _lastTotalMs;
    private bool _benchmarking;
    private string? _benchmark;

    private TileItem? Tile => Store.Project.FindTile(Room.TileId);
    private double Size => Math.Max(_view.Width, _view.Height);

    protected override void OnParametersSet()
    {
        if (!Result.Ok || ReferenceEquals(_renderedFor, Result)) return;
        _renderedFor = Result;

        var lay = Result.Layout!;
        var reused = Result.Cuts!.Assignments.Where(a => a.FromOffcut).Select(a => a.Piece.CutNo).ToHashSet();
        _regionPath = Svg.Path(Result.Region!);
        _roomPath = Svg.Path(Result.Polygon!);
        _fullPath = Svg.Path(lay.Pieces.Where(p => p.Kind == PieceKind.Full).Select(p => p.Shape));
        _cutPath = Svg.Path(lay.CutPieces.Where(p => !reused.Contains(p.CutNo)).Select(p => p.Shape));
        _reusePath = Svg.Path(lay.CutPieces.Where(p => reused.Contains(p.CutNo)).Select(p => p.Shape));

        var poly = Result.Polygon!;
        _violations = Result.Offset!.Violations.Select(w => (poly[w.Index], poly[(w.Index + 1) % poly.Count])).ToList();

        if (_viewFor != Room.Id) { _viewFor = Room.Id; _view = poly.Bounds; }
        double reach = Math.Sqrt(_view.Width * _view.Width + _view.Height * _view.Height);
        var dir = Vec2.FromAngle(Room.BaselineAngleDeg * Math.PI / 180);
        _baseA = Room.BaselineOrigin.ToVec() - dir * reach * 0.05;
        _baseB = Room.BaselineOrigin.ToVec() + dir * reach;

        // 排版重算後，原本選取的那一格若還在就保留
        if (_selected is not null)
            _selected = lay.Pieces.FirstOrDefault(p => p.I == _selected.I && p.J == _selected.J);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_changeStartedAt is { } start)
        {
            _changeStartedAt = null;
            var painted = await (await Js.Module()).InvokeAsync<double>("afterPaint");
            _lastTotalMs = painted - start;
            if (!_benchmarking) StateHasChanged();
        }
    }

    private void OnCanvasClick((double X, double Y, string? Handle) e)
    {
        var p = new Vec2(e.X, e.Y);
        _selected = Result.Layout?.Pieces.FirstOrDefault(piece => piece.Shape.Contains(p));
    }

    private async Task ChangeJoint(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var mm) || mm < 0) return;
        await ApplyJoint(mm);
    }

    /// <summary>修改縫寬並記下時間點；畫面真的畫出來後（afterPaint）算出總耗時。</summary>
    private async Task ApplyJoint(double mm)
    {
        _changeStartedAt = await (await Js.Module()).InvokeAsync<double>("now");
        Tile!.JointMm = mm;
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// 驗收 11：交替修改縫寬 10 次，量測「重新排版＋重繪」的時間。
    /// 每次之間停 0.5 秒（模擬真人操作），避免前一次觸發的自動儲存與這一次的量測重疊。
    /// </summary>
    private async Task Benchmark()
    {
        _benchmarking = true;
        double original = Tile!.JointMm;
        var samples = new List<double>();
        for (int k = 0; k < 10; k++)
        {
            await Task.Delay(500);
            await ApplyJoint(original + (k % 2 == 0 ? 0.5 : 1.0));
            await Task.Yield();
            while (_changeStartedAt is not null) await Task.Delay(5);
            samples.Add(_lastTotalMs ?? 0);
        }
        await Task.Delay(500);
        await ApplyJoint(original);
        while (_changeStartedAt is not null) await Task.Delay(5);
        _lastTotalMs = null;   // 改回原值那一次不列入量測
        samples.Sort();
        _benchmark = $"10 次：中位數 {samples[5]:0} ms、最慢 {samples[^1]:0} ms（{Result.Layout!.Pieces.Count} 片）";
        _benchmarking = false;
    }
}
